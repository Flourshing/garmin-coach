# 复制本文件为 .env（或本机使用的 .private/.env.dsh），填入真实值。
# 切勿把真实密钥提交到 Git。

# ---- 模型（必填）----
# DeepSeek 官方 API 密钥，来自 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里填你的密钥

# ---- 网关（云端部署时必填）----
# 云端网关访问令牌，请自己生成一个足够长的随机字符串
# 本机 local 模式会由 prepare_openclaw.py 自动生成
OPENCLAW_GATEWAY_TOKEN=

# ---- 可选 ----
# 启用 HTTPS 后填写公开域名，例如 https://coach.example.com
OPENCLAW_PUBLIC_ORIGIN=
# 监听端口，云端通常为 8080
PORT=8080
# 佳明数据目录（云端建议 /data/garmin）
GARMIN_DATA_DIR=

# ---- 可选：指定 Node 路径 ----
# 需要一个满足 openclaw 2026.10.6 要求的 Node：
#   >=24.22.1 <25  或  >=26.12.1
OPENCLAW_NODE=